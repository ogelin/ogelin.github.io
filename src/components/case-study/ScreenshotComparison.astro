---
interface Props {
  eyebrow: string;
  title: string;
  desktopSrc: string;
  desktopAlt: string;
  phoneSrc: string;
  phoneAlt: string;
  phoneSrcSecondary?: string;
  phoneAltSecondary?: string;
  caption: string;
  featured?: boolean;
  desktopWidth?: number;
  desktopHeight?: number;
  phoneWidth?: number;
  phoneHeight?: number;
}

const {
  eyebrow,
  title,
  desktopSrc,
  desktopAlt,
  phoneSrc,
  phoneAlt,
  phoneSrcSecondary,
  phoneAltSecondary,
  caption,
  featured = false,
  desktopWidth = 1505,
  desktopHeight = 1045,
  phoneWidth = 853,
  phoneHeight = 1844,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const assetPath = (src: string) => `${base}/${src.replace(/^\//, '')}`;
const comparisonId = `comparison-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')}`;
---

<figure class:list={["screenshot-comparison", { featured, "phone-pair": phoneSrcSecondary }]} data-screenshot-comparison>
  <header>
    <p>{eyebrow}</p>
    <h3>{title}</h3>
  </header>

  <div class="screens">
    <section class="screen desktop-screen">
      <span>Before</span>
      <img src={assetPath(desktopSrc)} alt={desktopAlt} width={desktopWidth} height={desktopHeight} loading={featured ? "eager" : "lazy"} />
    </section>

    <section class:list={["screen", "phone-screen", { "has-pair": phoneSrcSecondary }]}>
      <div class="screen-heading">
        <span>After</span>
        <button type="button" class="see-before" aria-haspopup="dialog" aria-controls={comparisonId}>
          See before
        </button>
      </div>

      <div
        class="phone-images"
        data-carousel={phoneSrcSecondary ? "true" : undefined}
        role={phoneSrcSecondary ? "region" : undefined}
        aria-label={phoneSrcSecondary ? "Mobile screen carousel" : undefined}
      >
        <img
          src={assetPath(phoneSrc)}
          alt={phoneAlt}
          width={phoneWidth}
          height={phoneHeight}
          loading={featured ? "eager" : "lazy"}
          data-carousel-slide
          draggable="false"
        />
        {phoneSrcSecondary && (
          <img
            src={assetPath(phoneSrcSecondary)}
            alt={phoneAltSecondary ?? ""}
            width={phoneWidth}
            height={phoneHeight}
            loading={featured ? "eager" : "lazy"}
            data-carousel-slide
            draggable="false"
          />
        )}
      </div>

      {phoneSrcSecondary && (
        <div class="carousel-controls" aria-label="Mobile screen carousel controls">
          <button type="button" class="carousel-button carousel-previous" aria-label="Previous mobile screen">
            <span aria-hidden="true">←</span>
            <span>Previous</span>
          </button>
          <div class="carousel-position" aria-live="polite">
            <div class="carousel-dots" aria-hidden="true">
              <i class="is-current"></i>
              <i></i>
            </div>
            <span><strong data-carousel-current>1</strong> of 2</span>
          </div>
          <button type="button" class="carousel-button carousel-next" aria-label="Next mobile screen">
            <span>Next</span>
            <span aria-hidden="true">→</span>
          </button>
        </div>
      )}
    </section>
  </div>

  <figcaption>{caption}</figcaption>

  <dialog id={comparisonId} class="before-dialog" aria-label={`Before: ${title}`}>
    <button type="button" class="close-dialog" aria-label="Close before image">
      <span aria-hidden="true">×</span>
    </button>
    <div class="lightbox-stage">
      <img
        src={assetPath(desktopSrc)}
        alt={desktopAlt}
        width={desktopWidth}
        height={desktopHeight}
        loading="lazy"
        class="lightbox-image"
        tabindex="0"
        role="button"
        aria-label="Zoom the before image"
        aria-pressed="false"
      />
    </div>
    <p class="dialog-caption">
      <strong>Before</strong>
      <span>{desktopAlt}</span>
      <small>Tap the image to zoom; pinch or drag to inspect.</small>
    </p>
  </dialog>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-screenshot-comparison]').forEach((comparison) => {
    if (comparison.dataset.ready === 'true') return;

    const openButton = comparison.querySelector<HTMLButtonElement>('.see-before');
    const dialog = comparison.querySelector<HTMLDialogElement>('.before-dialog');
    const closeButton = comparison.querySelector<HTMLButtonElement>('.close-dialog');
    const stage = comparison.querySelector<HTMLElement>('.lightbox-stage');
    const lightboxImage = comparison.querySelector<HTMLImageElement>('.lightbox-image');

    if (!openButton || !dialog || !closeButton || !stage || !lightboxImage) return;
    comparison.dataset.ready = 'true';

    const setZoom = (zoomed: boolean) => {
      lightboxImage.classList.toggle('is-zoomed', zoomed);
      lightboxImage.setAttribute('aria-pressed', String(zoomed));
      lightboxImage.setAttribute('aria-label', zoomed ? 'Fit the before image to the screen' : 'Zoom the before image');

      if (zoomed) {
        requestAnimationFrame(() => {
          stage.scrollLeft = Math.max(0, (stage.scrollWidth - stage.clientWidth) / 2);
          stage.scrollTop = Math.max(0, (stage.scrollHeight - stage.clientHeight) / 2);
        });
      } else {
        stage.scrollTo({ top: 0, left: 0 });
      }
    };

    openButton.addEventListener('click', () => {
      setZoom(false);
      dialog.showModal();
    });
    closeButton.addEventListener('click', () => dialog.close());
    lightboxImage.addEventListener('click', () => setZoom(!lightboxImage.classList.contains('is-zoomed')));
    lightboxImage.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        setZoom(!lightboxImage.classList.contains('is-zoomed'));
      }
    });
    stage.addEventListener('click', (event) => {
      if (event.target === stage) dialog.close();
    });
    dialog.addEventListener('close', () => setZoom(false));

    const carousel = comparison.querySelector<HTMLElement>('[data-carousel="true"]');
    const previous = comparison.querySelector<HTMLButtonElement>('.carousel-previous');
    const next = comparison.querySelector<HTMLButtonElement>('.carousel-next');
    const current = comparison.querySelector<HTMLElement>('[data-carousel-current]');
    const dots = Array.from(comparison.querySelectorAll<HTMLElement>('.carousel-dots i'));

    if (!carousel || !previous || !next || !current) return;

    const slides = Array.from(carousel.querySelectorAll<HTMLElement>('[data-carousel-slide]'));
    let activeIndex = 0;
    let scrollFrame = 0;
    let dragPointer: number | null = null;
    let dragStartX = 0;
    let dragStartScroll = 0;
    let dragMoved = false;
    let suppressClick = false;

    const getNearestIndex = () => {
      const carouselCenter = carousel.scrollLeft + (carousel.clientWidth / 2);
      const distances = slides.map((slide) => Math.abs((slide.offsetLeft + (slide.clientWidth / 2)) - carouselCenter));
      return distances.indexOf(Math.min(...distances));
    };

    const updateCarousel = (index: number, move = false) => {
      activeIndex = Math.max(0, Math.min(index, slides.length - 1));
      current.textContent = String(activeIndex + 1);
      previous.disabled = activeIndex === 0;
      next.disabled = activeIndex === slides.length - 1;
      dots.forEach((dot, dotIndex) => dot.classList.toggle('is-current', dotIndex === activeIndex));
      slides.forEach((slide, slideIndex) => slide.classList.toggle('is-current', slideIndex === activeIndex));

      if (move) {
        const activeSlide = slides[activeIndex];
        const left = activeSlide.offsetLeft - ((carousel.clientWidth - activeSlide.clientWidth) / 2);
        carousel.scrollTo({ left, behavior: 'smooth' });
      }
    };

    previous.addEventListener('click', () => updateCarousel(activeIndex - 1, true));
    next.addEventListener('click', () => updateCarousel(activeIndex + 1, true));
    slides.forEach((slide, slideIndex) => {
      slide.addEventListener('click', () => {
        if (suppressClick || slideIndex === activeIndex) return;
        updateCarousel(slideIndex, true);
      });
    });

    carousel.addEventListener('pointerdown', (event) => {
      if (!event.isPrimary || event.button !== 0 || carousel.scrollWidth <= carousel.clientWidth + 2) return;
      dragPointer = event.pointerId;
      dragStartX = event.clientX;
      dragStartScroll = carousel.scrollLeft;
      dragMoved = false;
      carousel.classList.add('is-dragging');
      carousel.setPointerCapture(event.pointerId);
    });
    carousel.addEventListener('pointermove', (event) => {
      if (dragPointer !== event.pointerId) return;
      const distance = event.clientX - dragStartX;
      dragMoved ||= Math.abs(distance) > 5;
      carousel.scrollLeft = dragStartScroll - distance;
    });

    const finishDrag = (event: PointerEvent) => {
      if (dragPointer !== event.pointerId) return;
      suppressClick = dragMoved;
      const pointerId = dragPointer;
      dragPointer = null;
      carousel.classList.remove('is-dragging');
      if (carousel.hasPointerCapture(pointerId)) carousel.releasePointerCapture(pointerId);
      updateCarousel(getNearestIndex(), true);
      window.setTimeout(() => { suppressClick = false; }, 0);
    };

    carousel.addEventListener('pointerup', finishDrag);
    carousel.addEventListener('pointercancel', finishDrag);
    carousel.addEventListener('lostpointercapture', (event) => {
      if (dragPointer !== event.pointerId) return;
      dragPointer = null;
      dragMoved = false;
      suppressClick = false;
      carousel.classList.remove('is-dragging');
      updateCarousel(getNearestIndex(), true);
    });
    carousel.addEventListener('dragstart', (event) => event.preventDefault());
    carousel.addEventListener('scroll', () => {
      cancelAnimationFrame(scrollFrame);
      scrollFrame = requestAnimationFrame(() => {
        updateCarousel(getNearestIndex());
      });
    }, { passive: true });
    window.addEventListener('resize', () => updateCarousel(activeIndex, true));
    updateCarousel(0);
  });
</script>

<style>
  .screenshot-comparison {
    width: min(74rem, calc(100vw - 2rem));
    margin: 2.4rem 50%;
    transform: translateX(-50%);
    padding: clamp(.85rem, 2.2vw, 1.35rem);
    border: 1px solid #b9c2bc;
    background: #f7faf8;
    color: #25312b;
    font-family: Arial, Helvetica, sans-serif;
  }

  .screenshot-comparison.featured {
    margin-top: 2rem;
    border-color: #8fa198;
  }

  header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: .8rem;
  }

  header p {
    margin: 0 !important;
    color: #627168;
    font-size: .67rem;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  header h3 {
    margin: 0 !important;
    color: #25312b;
    font: 700 clamp(1.05rem, 2vw, 1.3rem)/1.25 Georgia, "Times New Roman", serif !important;
    text-align: right;
  }

  .screens {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(12rem, 1fr);
    gap: clamp(.75rem, 2vw, 1.25rem);
    align-items: start;
  }

  .screenshot-comparison.phone-pair .screens {
    grid-template-columns: minmax(0, 3.3fr) minmax(18rem, 1.7fr);
  }

  .screen {
    margin: 0;
  }

  .screen > span,
  .screen-heading > span {
    display: block;
    margin-bottom: .35rem;
    color: #5e6b64;
    font-size: .68rem;
    font-weight: 700;
  }

  .screen-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .75rem;
  }

  .see-before {
    display: none;
    align-items: center;
    gap: .35rem;
    min-height: 2.2rem;
    border: 1px solid #173f72;
    border-radius: 999px;
    padding: .5rem .85rem;
    background: transparent;
    color: #173f72;
    font: 700 .76rem/1 Arial, Helvetica, sans-serif;
    cursor: pointer;
    transition: background-color 180ms ease, color 180ms ease, transform 180ms ease;
  }

  .see-before::after {
    content: "↗";
    transition: transform 180ms ease;
  }

  .see-before:hover,
  .see-before:focus-visible {
    background: #173f72;
    color: #fff;
    animation-play-state: paused;
    transform: translateY(-1px);
  }

  .see-before:hover::after,
  .see-before:focus-visible::after {
    transform: translate(.12rem, -.12rem);
  }

  .see-before:focus-visible,
  .close-dialog:focus-visible,
  .carousel-button:focus-visible,
  .lightbox-image:focus-visible {
    outline: 3px solid #e2a928;
    outline-offset: 3px;
  }

  .screen img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid #c7cfca;
    background: white;
  }

  .phone-images {
    display: grid;
    gap: .5rem;
  }

  .phone-screen.has-pair .phone-images {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
  }

  .carousel-controls {
    display: none;
  }

  figcaption {
    margin-top: .75rem;
    color: #59665f;
    font-size: .72rem;
    line-height: 1.5;
  }

  .before-dialog {
    inset: 0;
    width: auto;
    max-width: none;
    height: auto;
    max-height: none;
    margin: 0;
    border: 0;
    padding: 0;
    overflow: hidden;
    background: rgba(0, 0, 0, .88);
    color: #fff;
  }

  .before-dialog::backdrop {
    background: rgba(0, 0, 0, .72);
  }

  .close-dialog {
    position: absolute;
    z-index: 4;
    top: max(.8rem, env(safe-area-inset-top));
    right: max(1.25rem, env(safe-area-inset-right));
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, .78);
    border-radius: 50%;
    background: rgba(0, 0, 0, .42);
    color: #fff;
    font: 300 1.75rem/1 Arial, Helvetica, sans-serif;
    cursor: pointer;
  }

  .close-dialog:hover {
    background: rgba(255, 255, 255, .16);
  }

  .lightbox-stage {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 4rem 1.5rem 7.5rem;
    overflow: auto;
    overscroll-behavior: contain;
    touch-action: pan-x pan-y pinch-zoom;
  }

  .lightbox-image {
    display: block;
    width: min(100%, 74rem);
    height: auto;
    max-height: calc(100dvh - 11.5rem);
    object-fit: contain;
    border: 1px solid rgba(255, 255, 255, .22);
    background: #fff;
    cursor: zoom-in;
    -webkit-user-select: none;
    user-select: none;
  }

  .lightbox-image.is-zoomed {
    width: auto;
    max-width: none;
    max-height: none;
    cursor: zoom-out;
  }

  .dialog-caption {
    position: absolute;
    z-index: 3;
    right: 1rem;
    bottom: max(.85rem, env(safe-area-inset-bottom));
    left: 1rem;
    display: flex;
    align-items: baseline;
    justify-content: flex-start;
    gap: .45rem;
    margin: 0 !important;
    color: rgba(255, 255, 255, .88);
    font: 400 .76rem/1.4 Arial, Helvetica, sans-serif;
    text-align: left;
    text-shadow: 0 1px 2px #000;
    pointer-events: none;
  }

  .dialog-caption strong {
    color: #fff;
  }

  .dialog-caption small {
    color: rgba(255, 255, 255, .68);
    font-size: .68rem;
  }

  @keyframes see-before-bounce {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-.2rem);
    }
  }

  @media (max-width: 720px) {
    .screenshot-comparison {
      width: calc(100vw - 1rem);
    }

    header {
      display: block;
    }

    header h3 {
      margin-top: .18rem !important;
      text-align: left;
    }

    .screens,
    .screenshot-comparison.phone-pair .screens {
      grid-template-columns: 1fr;
    }

    .desktop-screen {
      display: none;
    }

    .phone-screen,
    .phone-screen.has-pair {
      width: min(100%, 24rem);
      margin-inline: auto;
      border: 0;
      background: transparent;
      box-shadow: none;
    }

    .screen-heading {
      min-height: 2.75rem;
      padding: 0 0 .5rem;
      border: 0;
      background: transparent;
    }

    .screen-heading > span {
      margin: 0;
      color: #25312b;
      font-size: .78rem;
    }

    .see-before {
      display: inline-flex;
      animation: see-before-bounce .9s ease-in-out infinite;
    }

    .phone-images,
    .phone-screen.has-pair .phone-images {
      display: grid;
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 86%;
      gap: .65rem;
      padding-inline: 7%;
      overflow-x: auto;
      scroll-behavior: smooth;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: 7%;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      cursor: grab;
      touch-action: pan-y pinch-zoom;
      -webkit-mask-image: linear-gradient(to right, transparent 0, #000 7%, #000 93%, transparent 100%);
      mask-image: linear-gradient(to right, transparent 0, #000 7%, #000 93%, transparent 100%);
    }

    .phone-images::-webkit-scrollbar {
      display: none;
    }

    .phone-images.is-dragging {
      scroll-behavior: auto;
      scroll-snap-type: none;
      cursor: grabbing;
    }

    .phone-images img {
      scroll-snap-align: center;
      scroll-snap-stop: always;
      border-color: #aebbb4;
      opacity: .45;
      transition: opacity 180ms ease;
      -webkit-user-drag: none;
      -webkit-user-select: none;
      user-select: none;
    }

    .phone-images img.is-current {
      opacity: 1;
    }

    .carousel-controls {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: .5rem;
      margin-top: .65rem;
    }

    .carousel-button {
      display: inline-flex;
      min-height: 2.4rem;
      align-items: center;
      justify-content: center;
      gap: .35rem;
      border: 0;
      border-radius: 999px;
      background: transparent;
      color: #173f72;
      font: 700 .72rem/1 Arial, Helvetica, sans-serif;
      cursor: pointer;
    }

    .carousel-button:last-child {
      justify-self: end;
    }

    .carousel-button:disabled {
      color: #8d9892;
      cursor: default;
    }

    .carousel-position {
      display: grid;
      gap: .25rem;
      min-width: 3rem;
      justify-self: start;
      color: #59665f;
      font-size: .66rem;
      text-align: left;
    }

    .carousel-dots {
      display: flex;
      justify-content: flex-start;
      gap: .3rem;
    }

    .carousel-dots i {
      width: .42rem;
      height: .42rem;
      border-radius: 50%;
      background: #aebbb4;
    }

    .carousel-dots i.is-current {
      background: #173f72;
    }

    .dialog-caption {
      display: grid;
      gap: .15rem;
      padding-inline: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .see-before {
      animation: none;
      transition: none;
    }

    .phone-images {
      scroll-behavior: auto;
    }
  }
</style>
