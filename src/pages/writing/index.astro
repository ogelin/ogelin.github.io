---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('writing', ({ data }) => !data.draft)).sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---
<BaseLayout title="Writing" description="Engineering essays and technical notes by Olivia Gélinas.">
  <section class="shell section">
    <div class="section-head"><h1>Writing</h1></div>
    <ul class="list">{posts.map((post) => <li><time datetime={post.data.published.toISOString()}>{post.data.published.toLocaleDateString('en-CA', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' })}</time><div><h2><a href={`${base}writing/${post.id}/`}>{post.data.title}</a></h2><p>{post.data.description}</p></div></li>)}</ul>
  </section>
</BaseLayout>
